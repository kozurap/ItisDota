@page "/groups/{GroupId:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject PromptScope Scopes
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>@(_room?.Name ?? "Комната")</PageTitle>

@if (_room is null)
{
    <div class="app-card col-lg-6">
        <h1 class="h3 mb-3">Комната недоступна</h1>
        <p class="text-muted">
            Вы не состоите в этой группе. Попросите у друзей ссылку-приглашение — по ней вы попадёте в комнату.
        </p>
        <a class="btn btn-outline-secondary" href="groups">Мои группы</a>
    </div>
}
else
{
    <div class="app-page-head">
        <h1 class="h3 mb-0">@_room.Name</h1>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CopyInviteAsync">
                Копировать ссылку-приглашение
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="OpenRoster">
                Показать всех игроков
            </button>
            <button type="button" class="btn btn-sm @(_amReady ? "btn-secondary" : "btn-primary")"
                    disabled="@(_profileIncomplete || _busy)" @onclick="ToggleReadyAsync">
                @(_amReady ? "Не готов" : "Я готов")
            </button>
        </div>
    </div>

    @if (_profileIncomplete)
    {
        <div class="alert alert-warning" role="alert">
            Ваш профиль не заполнен: укажите ПТС и приоритеты ролей.
            <a href="profile">Перейти в профиль</a>
        </div>
    }
    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="alert alert-success" role="alert">@_statusMessage</div>
    }
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }

    <div class="app-card mb-4">
        <h2 class="h5 mb-3">Готовы играть · @ReadyCount</h2>
        @if (ReadyCount == 0)
        {
            <p class="text-muted mb-0">Пока никто не готов.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                    <tr>
                        <th>Имя</th>
                        <th>Telegram</th>
                        <th>Цифры в стиме</th>
                        <th>ПТС</th>
                        <th>Приоритеты ролей</th>
                        <th>Статус</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var member in _members.Where(m => m.IsReady))
                    {
                        <tr>
                            <td>@member.RealName</td>
                            <td>@member.TgTag</td>
                            <td>@(member.SteamFriendId?.ToString() ?? "—")</td>
                            <td>@(member.Mmr > 0 ? member.Mmr.ToString() : "—")</td>
                            <td class="small text-nowrap">@RoleLine(member)</td>
                            <td>Готов</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="app-card">
                <h2 class="h5 mb-3">Промпт группы</h2>
                <div class="mb-3">
                    <label class="form-label" for="prompt-text">Текст промпта</label>
                    <textarea id="prompt-text" class="form-control" rows="8" @bind="_promptText"></textarea>
                </div>
                <button type="button" class="btn btn-secondary" disabled="@_busy" @onclick="SavePromptAsync">
                    Сохранить промпт
                </button>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="app-card">
                <h2 class="h5 mb-3">Отправить в Cursor</h2>
                <p class="text-muted small">Промпт собирается из игроков, которые нажали «Я готов». Нужно кратно 10 (10, 20, …).</p>
                <p class="small mb-2 @(BuildEnabled ? "text-success" : "text-muted")">@ReadyLabel</p>
                <button type="button" id="build-prompt-btn" class="btn btn-success mb-3"
                        disabled="@(!BuildEnabled || _busy)" @onclick="BuildPromptAsync">
                    Собрать промпт и скопировать
                </button>
                <div class="small mb-2 @_copyClass" aria-live="polite">@_copyStatus</div>
                @if (_generated is not null)
                {
                    <pre id="generated-prompt" class="app-prompt-out p-3 small" style="white-space: pre-wrap; min-height: 8rem;">@_generated</pre>
                }
            </div>
        </div>
    </div>

    @if (_rosterOpen)
    {
        <div class="room-drawer-backdrop" @onclick="CloseRoster"></div>
        <aside class="room-drawer" aria-label="Все игроки">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">Все игроки · @_members.Count</h2>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloseRoster">Закрыть</button>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                    <tr>
                        <th>Имя</th>
                        <th>Telegram</th>
                        <th>Цифры в стиме</th>
                        <th>ПТС</th>
                        <th>Приоритеты ролей</th>
                        <th>Статус</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var member in _members)
                    {
                        <tr>
                            <td>@member.RealName</td>
                            <td>@member.TgTag</td>
                            <td>@(member.SteamFriendId?.ToString() ?? "—")</td>
                            <td>@(member.Mmr > 0 ? member.Mmr.ToString() : "—")</td>
                            <td class="small">@RoleLine(member)</td>
                            <td>@(member.IsReady ? "Готов" : "Не готов")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </aside>
    }
}

@code {
    [Parameter]
    public int GroupId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private readonly List<RoomMemberDto> _members = new();
    private readonly CancellationTokenSource _pollCts = new();
    private GroupRoomDto? _room;
    private IJSObjectReference? _module;
    private string? _userId;
    private string _promptText = string.Empty;
    private string? _statusMessage;
    private string? _errorMessage;
    private string? _generated;
    private string _copyStatus = string.Empty;
    private string _copyClass = string.Empty;
    private bool _profileIncomplete;
    private bool _busy;
    private bool _rosterOpen;
    private bool _leaveWatching;
    private bool _disposed;

    private int ReadyCount => _members.Count(m => m.IsReady);

    private bool BuildEnabled => ReadyCount > 0 && ReadyCount % 10 == 0;

    private string ReadyLabel =>
        "Готовы: " + ReadyCount + (BuildEnabled ? "" : " (нужно кратно 10)");

    private bool _amReady =>
        _room is not null && _members.Any(m => m.Id == _room.CurrentPlayerId && m.IsReady);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadAsync();
            if (_room is not null)
            {
                _ = PollLoopAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Не удалось загрузить комнату: " + ex.Message;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _room is null || _leaveWatching)
        {
            return;
        }

        _leaveWatching = true;
        try
        {
            _module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/players.js");
            await _module.InvokeVoidAsync("watchRoomLeave", GroupId);
        }
        catch (Exception)
        {
            _leaveWatching = false;
        }
    }

    private async Task LoadAsync()
    {
        var userId = await CurrentUserIdAsync();
        _userId = userId;
        var groupId = GroupId;
        _room = await Scopes.UseAsync<GroupService, GroupRoomDto?>(s => s.GetRoomAsync(userId, groupId));
        if (_room is null)
        {
            return;
        }

        _promptText = _room.PromptText;
        _members.Clear();
        _members.AddRange(_room.Members);
        var profile = await Scopes.UseAsync<ProfileService, PlayerDto?>(s => s.GetAsync(userId));
        _profileIncomplete = profile is null || !ProfileService.IsComplete(profile);
    }

    private async Task RefreshMembersAsync()
    {
        if (_userId is null)
        {
            return;
        }

        var userId = _userId;
        var groupId = GroupId;
        var room = await Scopes.UseAsync<GroupService, GroupRoomDto?>(s => s.GetRoomAsync(userId, groupId));
        if (room is null)
        {
            return;
        }

        ApplyMembers(room.Members);
    }

    private void ApplyMembers(IReadOnlyList<RoomMemberDto> incoming)
    {
        var incomingById = incoming.ToDictionary(m => m.Id);
        var seen = new HashSet<int>();
        for (var i = 0; i < _members.Count; i++)
        {
            if (incomingById.TryGetValue(_members[i].Id, out var updated))
            {
                _members[i] = updated;
                seen.Add(updated.Id);
            }
        }

        _members.RemoveAll(m => !incomingById.ContainsKey(m.Id));
        foreach (var member in incoming)
        {
            if (!seen.Contains(member.Id))
            {
                _members.Add(member);
            }
        }
    }

    private async Task PollLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(4));
        try
        {
            while (await timer.WaitForNextTickAsync(_pollCts.Token))
            {
                try
                {
                    await RefreshMembersAsync();
                    await InvokeAsync(StateHasChanged);
                }
                catch (OperationCanceledException)
                {
                    throw;
                }
                catch (Exception)
                {
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task ToggleReadyAsync()
    {
        if (_busy || _room is null || _profileIncomplete || _userId is null)
        {
            return;
        }

        ClearAlerts();
        _busy = true;
        try
        {
            var userId = _userId;
            var groupId = GroupId;
            var next = !_amReady;
            await Scopes.UseAsync<GroupService>(s => s.SetReadyAsync(userId, groupId, next));
            await RefreshMembersAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SavePromptAsync()
    {
        if (_busy || _userId is null)
        {
            return;
        }

        ClearAlerts();
        _busy = true;
        try
        {
            var userId = _userId;
            var groupId = GroupId;
            var text = _promptText;
            await Scopes.UseAsync<GroupService>(s => s.SavePromptAsync(userId, groupId, text));
            _statusMessage = "Промпт сохранён.";
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task BuildPromptAsync()
    {
        if (_busy || _room is null || _userId is null)
        {
            return;
        }

        ClearAlerts();
        _busy = true;
        try
        {
            var ready = _members.Where(m => m.IsReady).ToList();
            _generated = PromptService.BuildFullPrompt(_promptText, ready.Select(m => m.ToPlayerDto()));

            var userId = _userId;
            var groupId = GroupId;
            var ids = ready.Select(m => m.Id).ToList();
            await Scopes.UseAsync<GroupService>(s => s.RecordSelectionsAsync(userId, groupId, ids));

            try
            {
                _module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/players.js");
                await _module.InvokeVoidAsync("copyText", _generated);
                _copyStatus = "Промпт скопирован в буфер обмена.";
                _copyClass = "text-success";
            }
            catch (Exception)
            {
                _copyStatus = "Не удалось скопировать автоматически — выделите текст ниже.";
                _copyClass = "text-warning";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CopyInviteAsync()
    {
        ClearAlerts();
        try
        {
            var url = Navigation.ToAbsoluteUri($"join/{_room!.InviteToken}").ToString();
            _module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/players.js");
            await _module.InvokeVoidAsync("copyText", url);
            _statusMessage = "Ссылка скопирована: " + url;
        }
        catch (Exception ex)
        {
            _errorMessage = "Не удалось скопировать ссылку: " + ex.Message;
        }
    }

    private void OpenRoster() => _rosterOpen = true;

    private void CloseRoster() => _rosterOpen = false;

    private void ClearAlerts()
    {
        _statusMessage = null;
        _errorMessage = null;
    }

    private static string RoleLine(RoomMemberDto member)
    {
        if (!ProfileService.IsComplete(member.ToPlayerDto()))
        {
            return "профиль не заполнен";
        }

        return $"1→{member.RolePriority1}, 2→{member.RolePriority2}, 3→{member.RolePriority3}, 4→{member.RolePriority4}, 5→{member.RolePriority5}";
    }

    private async Task<string> CurrentUserIdAsync()
    {
        var state = await AuthenticationState!;
        return state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            ?? throw new InvalidOperationException("Не удалось определить пользователя.");
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        _pollCts.Cancel();
        _pollCts.Dispose();

        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("clearRoomLeave");
            }
        }
        catch (Exception)
        {
        }

        if (_userId is null || _room is null)
        {
            return;
        }

        try
        {
            var userId = _userId;
            var groupId = GroupId;
            await Scopes.UseAsync<GroupService>(s => s.SetReadyAsync(userId, groupId, false));
        }
        catch (Exception)
        {
        }
    }
}
