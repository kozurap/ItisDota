@page "/login"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@inject KeycloakAuthService Auth
@inject NavigationManager Navigation

<PageTitle>Вход</PageTitle>

<div class="col-lg-5">
    <div class="app-card">
        <h1 class="h3 mb-3">Вход</h1>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

<EditForm Model="Input" OnValidSubmit="SubmitAsync" FormName="login" method="post" Enhance="false">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label class="form-label" for="login-username">Имя пользователя</label>
        <InputText id="login-username" class="form-control" @bind-Value="Input!.Username" autocomplete="username" />
        <ValidationMessage For="() => Input!.Username" class="text-danger" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="login-password">Пароль</label>
        <InputText type="password" id="login-password" class="form-control" @bind-Value="Input!.Password" autocomplete="current-password" />
        <ValidationMessage For="() => Input!.Password" class="text-danger" />
    </div>
    <button type="submit" class="btn btn-primary">Войти</button>
    <a class="btn btn-link" href="register" data-enhance-nav="false">Регистрация</a>
</EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private LoginInput? Input { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        if (AuthenticationState is null)
        {
            return;
        }

        var state = await AuthenticationState;
        if (state.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo(LocalReturnUrl(), forceLoad: true);
        }
    }

    private async Task SubmitAsync()
    {
        if (HttpContext is null)
        {
            _error = "Не удалось выполнить вход.";
            return;
        }

        var input = Input ?? new LoginInput();
        var result = await Auth.LoginAsync(input.Username, input.Password, HttpContext.RequestAborted);
        if (!result.Succeeded || result.Tokens is null)
        {
            _error = result.Error ?? "Не удалось выполнить вход.";
            return;
        }

        await Auth.SignInAsync(HttpContext, result.Tokens);
        Navigation.NavigateTo(LocalReturnUrl(), forceLoad: true);
    }

    private string LocalReturnUrl()
    {
        if (string.IsNullOrEmpty(ReturnUrl) || !ReturnUrl.StartsWith('/') || ReturnUrl.StartsWith("//", StringComparison.Ordinal))
        {
            return "/";
        }

        return ReturnUrl;
    }

    private sealed class LoginInput
    {
        [Required(ErrorMessage = "Введите имя пользователя")]
        public string Username { get; set; } = "";

        [Required(ErrorMessage = "Введите пароль")]
        public string Password { get; set; } = "";
    }
}
