@inherits LayoutComponentBase

<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark app-navbar mb-4">
        <div class="container">
            <a class="navbar-brand" href="">Itis<span>Dota</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <AuthorizeView>
                        <Authorized>
                            <li class="nav-item">
                                <a class="nav-link" href="groups" data-enhance-nav="false">Мои группы</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="profile" data-enhance-nav="false">Профиль</a>
                            </li>
                        </Authorized>
                    </AuthorizeView>
                </ul>
                <AuthorizeView>
                    <Authorized>
                        <ul class="navbar-nav align-items-center">
                            <li class="nav-item">
                                <span class="navbar-text app-user-chip me-2">@context.User.Identity?.Name</span>
                            </li>
                            <li class="nav-item">
                                <form method="post" action="logout" data-enhance="false" class="d-inline">
                                    <AntiforgeryToken />
                                    <button type="submit" class="nav-link btn btn-link">Выйти</button>
                                </form>
                            </li>
                        </ul>
                    </Authorized>
                    <NotAuthorized>
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link" href="login" data-enhance-nav="false">Вход</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="register" data-enhance-nav="false">Регистрация</a>
                            </li>
                        </ul>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @Body
    </main>
</div>

<footer class="footer">
    <div class="container">
        &copy; 2026 - ItisDota - <a href="privacy">Privacy</a>
    </div>
</footer>
