@page
@model IndexModel
@{
    ViewData["Title"] = "Игроки";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div class="row g-4">
    <div class="col-lg-5">
        <h2 class="h4 mb-3">Импорт JSON</h2>
        <form method="post" asp-page-handler="Import" enctype="multipart/form-data" id="import-form">
            <div id="json-dropzone" class="json-dropzone mb-3">
                <input type="file" asp-for="JsonFile" id="json-file" accept=".json,application/json" class="d-none" />
                <p class="mb-2 fw-semibold">Перетащите JSON-файл сюда</p>
                <p class="mb-3 text-muted small">или</p>
                <button type="button" id="json-file-btn" class="btn btn-outline-secondary btn-sm">Выбрать файл</button>
                <p id="json-file-name" class="mt-3 mb-0 small text-muted">Файл не выбран</p>
            </div>
            <div class="mb-3">
                <label asp-for="JsonInput" class="form-label">Или вставьте JSON участников</label>
                <textarea asp-for="JsonInput" class="form-control font-monospace" rows="10" placeholder="JSON массива игроков из формы"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Сохранить в базу</button>
        </form>
    </div>

    <div class="col-lg-7">
        <h2 class="h4 mb-3">Список игроков</h2>
        <form method="get" id="tg-search-form" class="row g-2 align-items-end mb-3" novalidate>
            <div class="col">
                <label asp-for="TgSearch" class="form-label">Поиск по Telegram</label>
                <div class="input-group tg-search-group">
                    <span class="input-group-text tg-search-prefix" aria-hidden="true">@@</span>
                    <input asp-for="TgSearch" id="TgSearch" class="form-control@(string.IsNullOrEmpty(Model.TgSearchError) ? "" : " is-invalid")"
                           placeholder="username" autocomplete="off" aria-describedby="tg-search-error" />
                </div>
                <div id="tg-search-error"
                     class="invalid-feedback@(string.IsNullOrEmpty(Model.TgSearchError) ? "" : " d-block")"
                     role="alert">@(Model.TgSearchError ?? "")</div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Найти</button>
                <a class="btn btn-outline-secondary" asp-page="/Index">Сброс</a>
            </div>
        </form>

        @if (Model.Players.Count == 0)
        {
            <p class="text-muted">Игроки не найдены. Импортируйте JSON или измените поиск.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle" id="players-table">
                    <thead>
                    <tr>
                        <th style="width: 2.5rem;">
                            <input type="checkbox" id="select-all" class="form-check-input" title="Выбрать всех" />
                        </th>
                        <th>Имя</th>
                        <th>Telegram</th>
                        <th>ПТС</th>
                        <th>Приоритеты ролей</th>
                        <th style="width: 5.5rem;"></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var player in Model.Players)
                    {
                        var tgNick = player.TgTag.StartsWith("@") ? player.TgTag[1..] : player.TgTag;
                        <tr data-id="@player.Id"
                            data-name="@player.RealName"
                            data-tag="@player.TgTag"
                            data-nick="@tgNick"
                            data-mmr="@player.MmRRange"
                            data-r1="@player.RolePriority1"
                            data-r2="@player.RolePriority2"
                            data-r3="@player.RolePriority3"
                            data-r4="@player.RolePriority4"
                            data-r5="@player.RolePriority5">
                            <td>
                                <input type="checkbox" class="form-check-input player-check" />
                            </td>
                            <td>@player.RealName</td>
                            <td>@player.TgTag</td>
                            <td>@player.MmRRange</td>
                            <td class="small text-nowrap">
                                1→@player.RolePriority1,
                                2→@player.RolePriority2,
                                3→@player.RolePriority3,
                                4→@player.RolePriority4,
                                5→@player.RolePriority5
                            </td>
                            <td>
                                <button type="button"
                                        class="btn btn-outline-primary btn-sm edit-player-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#edit-player-modal">
                                    Изменить
                                </button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<hr class="my-4" />

<div class="row g-4">
    <div class="col-lg-6">
        <h2 class="h4 mb-3">Промпт для сборки команд</h2>
        <form method="post" asp-page-handler="SavePrompt">
            <div class="mb-3">
                <label asp-for="PromptText" class="form-label">Текст промпта</label>
                <textarea asp-for="PromptText" id="prompt-text" class="form-control" rows="8"></textarea>
            </div>
            <button type="submit" class="btn btn-secondary">Сохранить промпт</button>
        </form>
    </div>

    <div class="col-lg-6">
        <h2 class="h4 mb-3">Отправить в Cursor</h2>
        <p class="text-muted small">Выберите игроков кратно 10 (10, 20, …), затем нажмите кнопку — готовый текст появится ниже и скопируется в буфер обмена.</p>
        <p id="selected-count" class="small mb-2 text-muted">Выбрано: 0</p>
        <button type="button" id="build-prompt-btn" class="btn btn-success mb-3" disabled>Собрать промпт и скопировать</button>
        <div id="copy-status" class="small mb-2" aria-live="polite"></div>
        <pre id="generated-prompt" class="border rounded p-3 bg-light small" style="white-space: pre-wrap; min-height: 8rem; display: none;"></pre>
    </div>
</div>

<div class="modal fade" id="edit-player-modal" tabindex="-1" aria-labelledby="edit-player-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Edit" id="edit-player-form">
                <div class="modal-header">
                    <h5 class="modal-title" id="edit-player-modal-label">Редактирование игрока</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="EditPlayer.Id" id="edit-id" />
                    <input type="hidden" name="TgSearch" value="@Model.TgSearch" />

                    <div class="mb-3">
                        <label asp-for="EditPlayer.RealName" class="form-label">Имя</label>
                        <input asp-for="EditPlayer.RealName" id="edit-name" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="EditPlayer.TgNick" class="form-label">Telegram</label>
                        <div class="input-group">
                            <span class="input-group-text tg-search-prefix" aria-hidden="true">@@</span>
                            <input asp-for="EditPlayer.TgNick" id="edit-tg-nick" class="form-control" placeholder="username" required />
                        </div>
                        <div class="form-text">Без символа @@ — он добавится автоматически.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EditPlayer.MmRRange" class="form-label">ПТС</label>
                        <input asp-for="EditPlayer.MmRRange" id="edit-mmr" class="form-control" required />
                    </div>

                    <div class="row g-2">
                        <div class="col">
                            <label asp-for="EditPlayer.RolePriority1" class="form-label">Роль 1</label>
                            <select asp-for="EditPlayer.RolePriority1" id="edit-r1" class="form-select">
                                @for (var r = 1; r <= 5; r++) { <option value="@r">@r</option> }
                            </select>
                        </div>
                        <div class="col">
                            <label asp-for="EditPlayer.RolePriority2" class="form-label">Роль 2</label>
                            <select asp-for="EditPlayer.RolePriority2" id="edit-r2" class="form-select">
                                @for (var r = 1; r <= 5; r++) { <option value="@r">@r</option> }
                            </select>
                        </div>
                        <div class="col">
                            <label asp-for="EditPlayer.RolePriority3" class="form-label">Роль 3</label>
                            <select asp-for="EditPlayer.RolePriority3" id="edit-r3" class="form-select">
                                @for (var r = 1; r <= 5; r++) { <option value="@r">@r</option> }
                            </select>
                        </div>
                        <div class="col">
                            <label asp-for="EditPlayer.RolePriority4" class="form-label">Роль 4</label>
                            <select asp-for="EditPlayer.RolePriority4" id="edit-r4" class="form-select">
                                @for (var r = 1; r <= 5; r++) { <option value="@r">@r</option> }
                            </select>
                        </div>
                        <div class="col">
                            <label asp-for="EditPlayer.RolePriority5" class="form-label">Роль 5</label>
                            <select asp-for="EditPlayer.RolePriority5" id="edit-r5" class="form-select">
                                @for (var r = 1; r <= 5; r++) { <option value="@r">@r</option> }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer justify-content-between">
                    <button type="submit"
                            class="btn btn-outline-danger"
                            formaction="?handler=Delete"
                            formmethod="post"
                            id="edit-delete-btn"
                            onclick="return confirm('Удалить этого игрока?');">
                        Удалить
                    </button>
                    <div>
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
                        <button type="submit" class="btn btn-primary" formaction="?handler=Edit">Сохранить</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const selectAll = document.getElementById('select-all');
    const checks = () => Array.from(document.querySelectorAll('.player-check'));
    const btn = document.getElementById('build-prompt-btn');
    const out = document.getElementById('generated-prompt');
    const status = document.getElementById('copy-status');
    const promptEl = document.getElementById('prompt-text');
    const selectedCountEl = document.getElementById('selected-count');
    const antiforgery = document.querySelector('input[name="__RequestVerificationToken"]');

    const tgSearchForm = document.getElementById('tg-search-form');
    const tgSearchInput = document.getElementById('TgSearch');
    const tgSearchError = document.getElementById('tg-search-error');
    const tgSearchAtError = 'Не указывайте символ @@ — он уже стоит слева от поля. Введите только ник.';

    function setTgSearchError(show) {
        if (!tgSearchInput || !tgSearchError) {
            return;
        }
        if (show) {
            tgSearchError.textContent = tgSearchAtError;
            tgSearchError.classList.add('d-block');
            tgSearchInput.classList.add('is-invalid');
        } else {
            tgSearchError.textContent = '';
            tgSearchError.classList.remove('d-block');
            tgSearchInput.classList.remove('is-invalid');
        }
    }

    if (tgSearchForm && tgSearchInput) {
        tgSearchForm.addEventListener('submit', function (e) {
            if (tgSearchInput.value.indexOf('@@') !== -1) {
                e.preventDefault();
                setTgSearchError(true);
            }
        });
        tgSearchInput.addEventListener('input', function () {
            if (tgSearchInput.value.indexOf('@@') === -1) {
                setTgSearchError(false);
            }
        });
    }

    function selectedCount() {
        return checks().filter(c => c.checked).length;
    }

    function updateBuildButton() {
        const count = selectedCount();
        const enabled = count > 0 && count % 10 === 0;
        btn.disabled = !enabled;
        selectedCountEl.textContent = 'Выбрано: ' + count + (enabled ? '' : ' (нужно кратно 10)');
        selectedCountEl.className = enabled ? 'small mb-2 text-success' : 'small mb-2 text-muted';
    }

    if (selectAll) {
        selectAll.addEventListener('change', function () {
            checks().forEach(c => { c.checked = selectAll.checked; });
            updateBuildButton();
        });
    }

    document.addEventListener('change', function (e) {
        if (e.target && e.target.classList && e.target.classList.contains('player-check')) {
            updateBuildButton();
        }
    });

    updateBuildButton();

    document.querySelectorAll('.edit-player-btn').forEach(function (button) {
        button.addEventListener('click', function () {
            const row = button.closest('tr');
            if (!row) {
                return;
            }
            document.getElementById('edit-id').value = row.dataset.id || '';
            document.getElementById('edit-name').value = row.dataset.name || '';
            document.getElementById('edit-tg-nick').value = row.dataset.nick || '';
            document.getElementById('edit-mmr').value = row.dataset.mmr || '';
            document.getElementById('edit-r1').value = row.dataset.r1 || '1';
            document.getElementById('edit-r2').value = row.dataset.r2 || '2';
            document.getElementById('edit-r3').value = row.dataset.r3 || '3';
            document.getElementById('edit-r4').value = row.dataset.r4 || '4';
            document.getElementById('edit-r5').value = row.dataset.r5 || '5';
        });
    });

    const editForm = document.getElementById('edit-player-form');
    const editTgNick = document.getElementById('edit-tg-nick');
    if (editForm && editTgNick) {
        editForm.addEventListener('submit', function (e) {
            if (editTgNick.value.indexOf('@@') !== -1) {
                e.preventDefault();
                alert('Не указывайте символ @@ в Telegram-нике — он добавляется автоматически.');
            }
        });
    }

    function formatPlayer(row) {
        return row.dataset.name + ' (' + row.dataset.tag + ') — MMR: ' + row.dataset.mmr +
            '; приоритеты: 1→' + row.dataset.r1 +
            ', 2→' + row.dataset.r2 +
            ', 3→' + row.dataset.r3 +
            ', 4→' + row.dataset.r4 +
            ', 5→' + row.dataset.r5;
    }

    function getAntiforgeryToken() {
        if (antiforgery && antiforgery.value) {
            return antiforgery.value;
        }
        const formToken = document.querySelector('#import-form input[name="__RequestVerificationToken"]');
        return formToken ? formToken.value : '';
    }

    btn.addEventListener('click', async function () {
        const selected = checks()
            .filter(c => c.checked)
            .map(c => c.closest('tr'));

        if (selected.length === 0 || selected.length % 10 !== 0) {
            status.textContent = 'Число выбранных игроков должно делиться на 10.';
            status.className = 'small mb-2 text-danger';
            return;
        }

        const ids = selected.map(row => Number(row.dataset.id));
        try {
            const response = await fetch('?handler=RecordSelections', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAntiforgeryToken()
                },
                body: JSON.stringify({ playerIds: ids })
            });
            if (!response.ok) {
                const payload = await response.json().catch(function () { return {}; });
                throw new Error(payload.error || 'Не удалось сохранить выбор игроков.');
            }
        } catch (e) {
            status.textContent = e.message || 'Ошибка при сохранении выбора.';
            status.className = 'small mb-2 text-danger';
            return;
        }

        const base = (promptEl && promptEl.value ? promptEl.value : '').trim();
        const lines = selected.map(formatPlayer);
        const text = base + '\n\nИгроки:\n' + lines.map(l => '- ' + l).join('\n');

        out.style.display = 'block';
        out.textContent = text;

        try {
            await navigator.clipboard.writeText(text);
            status.textContent = 'Скопировано в буфер обмена. Вставьте в чат Cursor.';
            status.className = 'small mb-2 text-success';
        } catch (e) {
            status.textContent = 'Текст показан ниже. Скопируйте вручную (Ctrl+C), если буфер недоступен.';
            status.className = 'small mb-2 text-warning';
            const range = document.createRange();
            range.selectNodeContents(out);
            const sel = window.getSelection();
            sel.removeAllRanges();
            sel.addRange(range);
        }
    });

    const dropzone = document.getElementById('json-dropzone');
    const fileInput = document.getElementById('json-file');
    const fileBtn = document.getElementById('json-file-btn');
    const fileName = document.getElementById('json-file-name');
    const jsonInput = document.getElementById('JsonInput');

    function setFile(file) {
        if (!file) {
            fileName.textContent = 'Файл не выбран';
            return;
        }

        const dt = new DataTransfer();
        dt.items.add(file);
        fileInput.files = dt.files;
        fileName.textContent = 'Выбран файл: ' + file.name;

        const reader = new FileReader();
        reader.onload = function () {
            if (typeof reader.result === 'string' && jsonInput) {
                jsonInput.value = reader.result;
            }
        };
        reader.readAsText(file);
    }

    if (fileBtn && fileInput) {
        fileBtn.addEventListener('click', function () { fileInput.click(); });
        fileInput.addEventListener('change', function () {
            setFile(fileInput.files && fileInput.files[0] ? fileInput.files[0] : null);
        });
    }

    if (dropzone) {
        ['dragenter', 'dragover'].forEach(function (evt) {
            dropzone.addEventListener(evt, function (e) {
                e.preventDefault();
                e.stopPropagation();
                dropzone.classList.add('is-dragover');
            });
        });

        ['dragleave', 'drop'].forEach(function (evt) {
            dropzone.addEventListener(evt, function (e) {
                e.preventDefault();
                e.stopPropagation();
                dropzone.classList.remove('is-dragover');
            });
        });

        dropzone.addEventListener('drop', function (e) {
            const files = e.dataTransfer && e.dataTransfer.files;
            if (!files || files.length === 0) {
                return;
            }
            setFile(files[0]);
        });
    }
})();
</script>
}
